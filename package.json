{
  "name": "aws-sdk-complete-tutorial-comprehensive",
  "version": "1.0.0",
  "description": "Comprehensive AWS SDK tutorial with 30+ examples for each service, system design patterns, and production-ready code",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup/interactive-setup.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "example:iam:basic": "ts-node 01-iam/examples/01-basic-user-management.ts",
    "example:iam:roles": "ts-node 01-iam/examples/02-role-management.ts",
    "example:iam:policies": "ts-node 01-iam/examples/03-policy-management.ts",
    "example:s3:upload": "ts-node 02-s3/examples/01-basic-upload.ts",
    "example:s3:lifecycle": "ts-node 02-s3/examples/05-lifecycle-management.ts",
    "example:ec2:launch": "ts-node 03-ec2/examples/01-launch-instance.ts",
    "example:lambda:deploy": "ts-node 04-lambda/examples/01-create-function.ts",
    "example:dynamodb:crud": "ts-node 05-dynamodb/examples/01-basic-crud.ts",
    "example:eks:cluster": "ts-node 15-eks/examples/01-create-cluster.ts",
    "example:all": "npm run test"
  },
  "keywords": [
    "aws",
    "aws-sdk",
    "tutorial",
    "cloud",
    "infrastructure",
    "iam",
    "s3",
    "ec2",
    "lambda",
    "dynamodb",
